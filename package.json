{
  "name": "a2b",
  "version": "0.1.0",
  "private": true,
  "description": "Community-powered driving navigation in the browser: live routes, turn-by-turn voice, and road reports from other drivers.",
  "author": "Thaqif Syarafuddin bin Roslan",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaqif0709/a2b"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply a2b --local",
    "db:migrate:remote": "wrangler d1 migrations apply a2b --remote",
    "test": "node --no-warnings --test test/*.test.js",
    "places": "python3 scripts/build-places.py",
    "predeploy": "node scripts/check-places.mjs && node scripts/app-version.mjs",
    "construction": "python3 scripts/build-construction.py",
    "cameras": "node scripts/build-cameras.mjs",
    "transit": "python3 scripts/build-transit.py",
    "test:offline-browser": "node scripts/verify-offline-shell-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "wrangler": "4.151.3"
  }
}
